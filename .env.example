# Copy to .env.local (gitignored) or source ~/.dphm/env.sh.
# Secrets belong in your platform secret manager, never in a committed file —
# config/loader.py refuses to load a config containing a credential literal.

# ── Snowflake (dev: DPHM_TEST only) ──
DPHM_SF_ACCOUNT=<org>-<account>
DPHM_SF_USER=DPHM_DEV_SVC
DPHM_SF_KEY_PATH=$HOME/.dphm/keys/dphm_dev_key.p8
DPHM_SF_ROLE=DPHM_DEV
DPHM_SF_WAREHOUSE=DPHM_TEST_WH
DPHM_SF_DATABASE=DPHM_TEST

# ── RDS. Tests use an embedded PostgreSQL and need none of these. ──
DPHM_RDS_HOST=
DPHM_RDS_USER=
DPHM_RDS_PASSWORD=

# ── git, LLM ──
DPHM_GIT_TOKEN=
ANTHROPIC_API_KEY=

# ── local only ──
DPHM_DEV_AUTH=1
DPHM_PROJECTS_DIR=projects
