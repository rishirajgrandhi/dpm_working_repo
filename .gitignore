# Secrets come only from env vars backed by the platform secret manager (04 §4, 13 §3).
# A secret literal in a YAML file is a load-time error, not a gitignore problem.
.env
.env.*
!.env.example
# Credentials and connection config live outside the repo, in ~/.dphm/
*.p8
*.pem
*.key
