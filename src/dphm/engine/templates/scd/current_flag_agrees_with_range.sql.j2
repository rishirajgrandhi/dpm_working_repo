-- SCD 5: IS_CURRENT is true exactly when VALID_TO is the open sentinel.
-- Catches the flag and the range drifting apart.
select
    object_construct({% for k in business_key %}'{{ k }}', {{ k }}{{ "," if not loop.last }}{% endfor %}) as failing_key,
    'SCD_FLAG_RANGE_MISMATCH' as violation_code,
    object_construct('is_current', {{ is_current }}, 'valid_to', {{ valid_to }}) as detail
from {{ table }}
where {{ scope_predicate }}
  and {{ is_current }} is distinct from
      (coalesce({{ valid_to }}, '{{ open_end_sentinel }}'::timestamp_ntz)
       >= '{{ open_end_sentinel }}'::timestamp_ntz)
limit {{ sample_limit }}
